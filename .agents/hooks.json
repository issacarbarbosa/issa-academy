{
  "linter-automatico": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/run-linter.cjs",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "guardiao-documentacao": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/stop-guardian.cjs",
        "timeout": 15
      }
    ]
  }
}
